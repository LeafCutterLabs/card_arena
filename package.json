{
  "name": "sandbox-card-table",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"VITE,PARTY\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:party\"",
    "dev:client": "vite",
    "dev:party": "partykit dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy:party": "partykit deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "partysocket": "^1.0.2",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "partykit": "^0.0.115",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
